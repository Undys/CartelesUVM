# Dependencias
node_modules/

# Archivos de entorno y credenciales sensibles (¡NUNCA subir a GitHub!)
.env
.env.local
.env.*.local

# Archivos subidos por usuarios (evitar subir PDFs de prueba a git)
public/uploads/*
!public/uploads/.gitkeep

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db
