# ==============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - SISTEMA DE CARTELES UVM
# ==============================================================
# Copia este archivo como '.env' para definir tus credenciales locales.
# IMPORTANTE: El archivo '.env' está en .gitignore y NUNCA se sube a GitHub.

# Configuración de Base de Datos MySQL (XAMPP por defecto)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=evaluaciones_db

# Puerto del Servidor HTTP
PORT=3000

# Credenciales del Administrador Inicial
# Si no defines una contraseña aquí, el servidor generará una contraseña
# aleatoria temporal en la consola en su primera ejecución.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contrasena_por_una_segura
