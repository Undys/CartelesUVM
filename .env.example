# ==============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - SISTEMA DE CARTELES UVM
# ==============================================================
# Copia este archivo como '.env' para definir tus credenciales.
# IMPORTANTE: El archivo '.env' está en .gitignore y NUNCA se sube a GitHub.

# Configuración de Base de Datos (MySQL Local o TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=evaluaciones_db

# SSL / TLS para bases de datos en la nube (TiDB Cloud exige SSL obligatorio)
# Si te conectas a TiDB Cloud, déjalo en true. Para XAMPP local usa false.
DB_SSL=false

# Opcional: También puedes usar una URL de conexión directa (ej. TiDB Cloud / Render / Railway)
# DATABASE_URL=mysql://usuario:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/evaluaciones_db

# Puerto del Servidor HTTP
PORT=3000

# Credenciales del Administrador Inicial
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contrasena_por_una_segura

# Configuración de Correo SMTP (Outlook / Office 365 / Institucional UVM) para envío automático de datos de ingreso
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=tu_correo@outlook.com
SMTP_PASS=tu_contrasena_o_contrasena_de_aplicacion
SMTP_FROM="Sistema de Carteles UVM <tu_correo@outlook.com>"


